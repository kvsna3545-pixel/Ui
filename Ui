function KRYVEX.BuildScreenIntro(ScreenGui, TitleText, SubtitleText)
    local Theme = KRYVEX.Theme
    local FX = KRYVEX.HalloweenFX
    if not ScreenGui then return end
    if FX.ScreenIntroOnce and KRYVEX.ScreenIntroPlayed then return end
    KRYVEX.ScreenIntroPlayed = true

    local Root = Create("Frame", { Name = "HalloweenScreenIntro", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 200 })
    Root.Parent = ScreenGui

    local function Alive() return Root:IsDescendantOf(game) end
    local function ScreenSize()
        local size = Root.AbsoluteSize
        if size.X < 10 or size.Y < 10 then
            local camera = workspace.CurrentCamera
            return camera and camera.ViewportSize or Vector2.new(800, 450)
        end
        return size
    end

    task.delay(12, function() if Root.Parent then Root:Destroy() end end)

    local Dim = Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 2, 10), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0 })
    Dim.Parent = Root

    local MoonSize = math.clamp(math.floor(math.min(ScreenSize().X, ScreenSize().Y) * 0.34), 110, 200)
    local Moon = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.34, 0),
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.12, BorderSizePixel = 0, ZIndex = 2,
    })
    Moon.Parent = Root
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.5, 0)
    corner.Parent = Moon

    task.spawn(function()
        pcall(function()
            TweenService:Create(Dim, TweenInfo.new(0.5), { BackgroundTransparency = 0.45 }):Play()
            task.wait(0.55)
            TweenService:Create(Moon, TweenInfo.new(0.9, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(MoonSize, MoonSize) }):Play()
            task.wait(2.0)
            TweenService:Create(Dim, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(Moon, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Size = UDim2.fromOffset(0, 0) }):Play()
            task.wait(0.9)
        end)
        if Root.Parent then Root:Destroy() end
    end)
end

function KRYVEX.BuildSeasonFX(Window, Main, Header, Title)
    if not KRYVEX.ThemeSettings.Animation then return end
    if KRYVEX.Theme.IsHalloween then
        if KRYVEX.HalloweenFX.ScreenIntro then
            KRYVEX.BuildScreenIntro(Main.Parent, Window.Title, Window.Subtitle)
        end
