function KRYVEX:SetTheme(mode)
    mode = string.lower(tostring(mode or self.ThemeSettings.Theme or "halloween"))
    if mode == "auto" then
        local ok, d = pcall(function() return os.date("*t") end)
        local season = ok and type(d) == "table" and d.month == self.HalloweenSeason.Month and d.day >= self.HalloweenSeason.FromDay and d.day <= self.HalloweenSeason.ToDay
        mode = season and "halloween" or "normal"
    end
    mode = self.ThemeAliases[mode] or mode
    local themeKey = mode:gsub("^%l", string.upper)
    if not self.Themes[themeKey] then mode, themeKey = "halloween", "Halloween" end
    self.ThemeMode, self.Theme = mode, self.Themes[themeKey]
    self.ThemeSettings.Theme = mode
    return self.Theme
end
