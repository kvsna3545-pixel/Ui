function KRYVEX:CreateWindow(config)
    config = config or {}
    if config.Theme then KRYVEX:SetTheme(config.Theme) end
    if config.ThemeAnimation ~= nil then KRYVEX.ThemeSettings.Animation = config.ThemeAnimation ~= false end

    local Window = {}
    Window.Title = config.Title or "Kryvex Hub"
    Window.Subtitle = config.Subtitle or "Custom Library"
    Window.Size = config.Size or Vector2.new(700, 440)
    Window.MinSize = config.MinSize or Vector2.new(560, 360)
    Window.MaxSize = config.MaxSize or Vector2.new(1000, 650)
    Window.LastSize = Vector2.new(Window.Size.X, Window.Size.Y)
    Window.Tabs = {}
    Window.IsMinimized = false
    Window.IsHidden = false
    Window.Destroyed = false

    local ScreenGui = Create("ScreenGui", {
        Name = "KRYVEX_UI_" .. tostring(math.random(10000, 99999)),
        ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    ScreenGui.Parent = GetParent()
    Window.ScreenGui = ScreenGui

    local Main = Create("Frame", {
        Name = "Main",
        Size = UDim2.fromOffset(Window.Size.X, Window.Size.Y),
        Position = UDim2.new(0.5, -Window.Size.X / 2, 0.5, -Window.Size.Y / 2),
        BackgroundColor3 = KRYVEX.Theme.Background, BorderSizePixel = 0, ClipsDescendants = true,
    })
    Main.Parent = ScreenGui
    AddCorner(Main, 16)
    Window.Main = Main

    local MainSheen = Instance.new("UIGradient")
    MainSheen.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, KRYVEX.Theme.Sheen1),
        ColorSequenceKeypoint.new(0.45, KRYVEX.Theme.Sheen2),
        ColorSequenceKeypoint.new(1, KRYVEX.Theme.Sheen3),
    })
    MainSheen.Rotation = 35
    MainSheen.Parent = Main

    local BgImage = Create("ImageLabel", {
        Name = "BackgroundImage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Image = ResolveBackground() or "", ImageTransparency = KRYVEX.Background.Transparency,
        ScaleType = Enum.ScaleType.Crop, ZIndex = 0, Visible = ResolveBackground() ~= nil,
    })
    BgImage.Parent = Main
    AddCorner(BgImage, 16)
    Window.BgImage = BgImage
    FixImage(BgImage, "พื้นหลัง")

    local HideScale = Instance.new("UIScale")
    HideScale.Scale = 1
    HideScale.Parent = Main
    Window.HideScale = HideScale

    local Header = Create("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 58), BackgroundTransparency = 1, Active = true })
    Header.Parent = Main

    local Logo = Create("Frame", { Size = UDim2.fromOffset(36, 36), Position = UDim2.fromOffset(12, 11), BackgroundTransparency = 1 })
    Logo.Parent = Header
    AddCorner(Logo, 10)

    local LogoImage = Create("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = KRYVEX.LogoImage, ScaleType = Enum.ScaleType.Fit })
    LogoImage.Parent = Logo
    FixImage(LogoImage, "โลโก้")

    local Title = Create("TextLabel", {
        Size = UDim2.new(1, -180, 0, 24), Position = UDim2.fromOffset(58, 7),
        BackgroundTransparency = 1, Text = (KRYVEX.Theme.IsHalloween and "\u{1F383} " or "") .. Window.Title,
        TextColor3 = KRYVEX.Theme.Text, TextSize = 17, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    Title.Parent = Header

    local Subtitle = Create("TextLabel", {
        Size = UDim2.new(1, -180, 0, 20), Position = UDim2.fromOffset(58, 31),
        BackgroundTransparency = 1, Text = Window.Subtitle, TextColor3 = KRYVEX.Theme.SubText,
        TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    Subtitle.Parent = Header

    local MinimizeButton = Create("TextButton", {
        Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -90, 0, 11),
        BackgroundColor3 = KRYVEX.Theme.Card, Text = "-", TextColor3 = KRYVEX.Theme.Text, TextSize = 20, Font = Enum.Font.GothamBold, AutoButtonColor = false,
    })
    MinimizeButton.Parent = Header
    AddCorner(MinimizeButton, 10)
    Window.MinimizeButton = MinimizeButton

    local CloseButton = Create("TextButton", {
        Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -48, 0, 11),
        BackgroundColor3 = KRYVEX.Theme.Card, Text = "\u{D7}", TextColor3 = KRYVEX.Theme.Text, TextSize = 22, Font = Enum.Font.GothamBold, AutoButtonColor = false,
    })
    CloseButton.Parent = Header
    AddCorner(CloseButton, 10)
    Window.CloseButton = CloseButton

    KRYVEX.BuildSeasonFX(Window, Main, Header, Title)

    -- Dragging Window
    local dragging = false
    local dragStart, startPosition
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
        end
    end)

    -- Sidebar & Content
    local Sidebar = Create("Frame", { Name = "Sidebar", Size = UDim2.new(0, 190, 1, -58), Position = UDim2.fromOffset(0, 58), BackgroundColor3 = KRYVEX.Theme.Sidebar, BackgroundTransparency = KRYVEX.Glass.Sidebar, BorderSizePixel = 0 })
    Sidebar.Parent = Main

    local Profile = Create("Frame", { Size = UDim2.new(1, -20, 0, 76), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = KRYVEX.Theme.Card })
    Profile.Parent = Sidebar
    AddCorner(Profile, 10)

    local Avatar = Create("ImageLabel", { Size = UDim2.fromOffset(46, 46), Position = UDim2.fromOffset(10, 15), BackgroundTransparency = 1, Image = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=150&h=150" })
    Avatar.Parent = Profile
    AddCorner(Avatar, 10)

    local DisplayName = Create("TextLabel", { Size = UDim2.new(1, -70, 0, 21), Position = UDim2.fromOffset(64, 11), BackgroundTransparency = 1, Text = LocalPlayer.DisplayName, TextColor3 = KRYVEX.Theme.Text, TextSize = 13, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
    DisplayName.Parent = Profile

    local Username = Create("TextLabel", { Size = UDim2.new(1, -70, 0, 20), Position = UDim2.fromOffset(64, 34), BackgroundTransparency = 1, Text = "@" .. LocalPlayer.Name, TextColor3 = KRYVEX.Theme.SubText, TextSize = 10, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
    Username.Parent = Profile

    local TabHolder = Create("ScrollingFrame", { Name = "TabHolder", Size = UDim2.new(1, -20, 1, -105), Position = UDim2.fromOffset(10, 96), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = KRYVEX.Theme.Primary, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y })
    TabHolder.Parent = Sidebar

    local TabLayout = Instance.new("UIListLayout")
    TabLayout.Padding = UDim.new(0, 5)
    TabLayout.Parent = TabHolder

    local Content = Create("Frame", { Name = "Content", Size = UDim2.new(1, -190, 1, -58), Position = UDim2.new(0, 190, 0, 58), BackgroundTransparency = 1 })
    Content.Parent = Main
    Window.Content = Content

    -- Notification Holder
    local NotificationHolder = Create("Frame", { Size = UDim2.fromOffset(300, 500), Position = UDim2.new(1, -315, 0, 15), BackgroundTransparency = 1 })
    NotificationHolder.Parent = ScreenGui
    local NotificationLayout = Instance.new("UIListLayout")
    NotificationLayout.Padding = UDim.new(0, 8)
    NotificationLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    NotificationLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    NotificationLayout.Parent = NotificationHolder

    function Window:Notify(config)
        config = config or {}
        local Notification = Create("Frame", { Size = UDim2.fromOffset(280, 72), BackgroundColor3 = KRYVEX.Theme.Card })
        Notification.Parent = NotificationHolder
        AddCorner(Notification, 10)
        AddStroke(Notification, KRYVEX.Theme.Primary, 0.45, 1)

        local NTitle = Create("TextLabel", { Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 7), BackgroundTransparency = 1, Text = config.Title or "Kryvex Hub", TextColor3 = KRYVEX.Theme.Text, TextSize = 13, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left })
        NTitle.Parent = Notification

        local NContent = Create("TextLabel", { Size = UDim2.new(1, -20, 0, 35), Position = UDim2.fromOffset(10, 31), BackgroundTransparency = 1, Text = config.Content or "", TextColor3 = KRYVEX.Theme.SubText, TextSize = 11, Font = Enum.Font.Gotham, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top })
        NContent.Parent = Notification

        Notification.Position = UDim2.new(1, 40, 0, 0)
        PlayTween(Notification, 0.35, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint)

        task.delay(config.Duration or 3, function()
            if not Notification.Parent then return end
            local Out = PlayTween(Notification, 0.3, { Position = UDim2.new(1, 40, 0, 0), BackgroundTransparency = 1 })
            Out.Completed:Wait()
            Notification:Destroy()
        end)
        return Notification
    end

    function Window:Minimize(state)
        if Window.Destroyed or Window.IsHidden then return end
        if state == nil then state = not Window.IsMinimized end
        Window.IsMinimized = state
        if state then
            Window.LastSize = Vector2.new(Main.AbsoluteSize.X, Main.AbsoluteSize.Y)
            PlayTween(Main, 0.3, { Size = UDim2.fromOffset(Window.LastSize.X, 58) }, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
            MinimizeButton.Text = "+"
        else
            PlayTween(Main, 0.35, { Size = UDim2.fromOffset(Window.LastSize.X, Window.LastSize.Y) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            MinimizeButton.Text = "-"
        end
    end

    function Window:Hide()
        if Window.Destroyed or Window.IsHidden then return end
        Window.IsHidden = true
        Window.LastSize = Vector2.new(Main.AbsoluteSize.X, Main.AbsoluteSize.Y)
        Window.LastPosition = Main.Position
        Main.Active = false
        PlayTween(BgImage, 0.32, { ImageTransparency = 1 })
        PlayTween(HideScale, 0.32, { Scale = 0.82 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        PlayTween(Main, 0.32, { Position = UDim2.new(Window.LastPosition.X.Scale, Window.LastPosition.X.Offset, Window.LastPosition.Y.Scale, Window.LastPosition.Y.Offset + 20), BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.33, function()
            if Window.IsHidden and not Window.Destroyed then Main.Visible = false end
        end)
    end

    function Window:Show()
        if Window.Destroyed or not Window.IsHidden then return end
        Window.IsHidden = false
        Main.Visible = true
        local Position = Window.LastPosition or Main.Position
        Main.Position = UDim2.new(Position.X.Scale, Position.X.Offset, Position.Y.Scale, Position.Y.Offset + 20)
        HideScale.Scale = 0.82
        Main.BackgroundTransparency = 1
        BgImage.ImageTransparency = 1
        PlayTween(BgImage, 0.4, { ImageTransparency = KRYVEX.Background.Transparency })
        Main.Active = true
        PlayTween(HideScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        PlayTween(Main, 0.4, { Position = Position, BackgroundTransparency = KRYVEX.Glass.Main }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    function Window:ToggleVisibility()
        if Window.Destroyed then return end
        if Window.IsHidden then Window:Show() else Window:Hide() end
    end

    function Window:Destroy()
        if Window.Destroyed then return end
        Window.Destroyed = true
        PlayTween(BgImage, 0.3, { ImageTransparency = 1 })
        local tween = PlayTween(Main, 0.3, {
            Size = UDim2.fromOffset(Main.AbsoluteSize.X * 0.8, Main.AbsoluteSize.Y * 0.8),
            BackgroundTransparency = 1,
            Position = UDim2.new(Main.Position.X.Scale, Main.Position.X.Offset, Main.Position.Y.Scale, Main.Position.Y.Offset + 20)
        }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        tween.Completed:Connect(function()
            if ScreenGui then ScreenGui:Destroy() end
        end)
    end

    MinimizeButton.Activated:Connect(function()
        if Window.IsHidden then return end
        Window:Minimize(not Window.IsMinimized)
    end)

    CloseButton.Activated:Connect(function()
        Window:Destroy()
    end)

    -- Tab System
    function Window:Tab(config, icon)
        if type(config) == "table" then
            return Window:CreateTab(config.Title or config.Name or "Tab", config.Icon or icon)
        end
        return Window:CreateTab(config, icon)
    end

    function Window:CreateTab(name, icon)
        local Tab = {}
        Tab.Name = name or "Tab"
        Tab.Icon = icon
        Tab.Elements = {}
        table.insert(Window.Tabs, Tab)

        local TabButton = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = KRYVEX.Theme.Sidebar, BackgroundTransparency = 1,
            Text = Tab.Name, TextColor3 = KRYVEX.Theme.SubText, TextSize = 12, Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
        })
        TabButton.Parent = TabHolder
        AddCorner(TabButton, 8)
        local padding = Instance.new("UIPadding")
        padding.PaddingLeft = UDim.new(0, 12)
        padding.Parent = TabButton

        local iconKind, iconData = ResolveIcon(Tab.Icon)
        if iconKind then
            padding.PaddingLeft = UDim.new(0, 38)
            local IconObject = (iconKind == "image") and Create("ImageLabel", {
                Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, -26, 0.5, -9), BackgroundTransparency = 1,
                Image = iconData.Image or "", ImageColor3 = KRYVEX.Theme.SubText, ScaleType = Enum.ScaleType.Fit,
            }) or Create("TextLabel", {
                Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, -26, 0.5, -9), BackgroundTransparency = 1,
                Text = iconData, TextColor3 = KRYVEX.Theme.SubText, TextSize = 16, Font = Enum.Font.GothamBold,
            })
            IconObject.Parent = TabButton
            Tab.IconObject = IconObject
        end

        local Page = Create("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 2, ScrollBarImageColor3 = KRYVEX.Theme.Primary, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false,
        })
        Page.Parent = Content

        local PagePadding = Instance.new("UIPadding")
        PagePadding.PaddingTop = UDim.new(0, 12)
        PagePadding.PaddingBottom = UDim.new(0, 12)
        PagePadding.PaddingLeft = UDim.new(0, 12)
        PagePadding.PaddingRight = UDim.new(0, 12)
        PagePadding.Parent = Page

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Padding = UDim.new(0, 8)
        PageLayout.Parent = Page

        Tab.Button = TabButton
        Tab.Page = Page

        function Tab:Select()
            for _, other in ipairs(Window.Tabs) do
                if other.Button then
                    PlayTween(other.Button, 0.15, { BackgroundTransparency = 1, TextColor3 = KRYVEX.Theme.SubText })
                end
                if other.IconObject then
                    if other.IconObject:IsA("ImageLabel") then PlayTween(other.IconObject, 0.15, { ImageColor3 = KRYVEX.Theme.SubText })
                    else PlayTween(other.IconObject, 0.15, { TextColor3 = KRYVEX.Theme.SubText }) end
                end
                if other.Page then other.Page.Visible = false end
            end
            if Tab.IconObject then
                if Tab.IconObject:IsA("ImageLabel") then PlayTween(Tab.IconObject, 0.15, { ImageColor3 = KRYVEX.Theme.Text })
                else PlayTween(Tab.IconObject, 0.15, { TextColor3 = KRYVEX.Theme.Text }) end
            end
            PlayTween(TabButton, 0.15, { BackgroundColor3 = KRYVEX.Theme.PrimaryDark, BackgroundTransparency = 0.15, TextColor3 = KRYVEX.Theme.Text })
            Page.Visible = true
        end

        TabButton.Activated:Connect(function() Tab:Select() end)

        -- Elements inside Tab
        function Tab:CreateButton(config)
            config = config or {}
            local Button = Create("TextButton", {
                Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = KRYVEX.Theme.Card,
                Text = config.Name or "Button", TextColor3 = KRYVEX.Theme.Text, TextSize = 12, Font = Enum.Font.GothamMedium, AutoButtonColor = false,
            })
            Button.Parent = Page
            AddCorner(Button, KRYVEX.Corners.Element)
            AddStroke(Button, KRYVEX.Theme.Primary, 0.8, 1)

            Button.Activated:Connect(function()
                if config.Callback then task.spawn(config.Callback) end
            end)
            Button.MouseEnter:Connect(function() PlayTween(Button, 0.15, { BackgroundColor3 = KRYVEX.Theme.CardHover }) end)
            Button.MouseLeave:Connect(function() PlayTween(Button, 0.15, { BackgroundColor3 = KRYVEX.Theme.Card }) end)
            return Button
        end

        function Tab:CreateToggle(config)
            config = config or {}
            local state = config.Default or false
            local Frame = Create("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = KRYVEX.Theme.Card })
            Frame.Parent = Page
            AddCorner(Frame, KRYVEX.Corners.Element)

            local Label = Create("TextLabel", {
                Size = UDim2.new(1, -70, 1, 0), Position = UDim2.fromOffset(14, 0), BackgroundTransparency = 1,
                Text = config.Name or "Toggle", TextColor3 = KRYVEX.Theme.Text, TextSize = 12, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
            })
            Label.Parent = Frame

            local Toggle = Create("TextButton", {
                Size = UDim2.fromOffset(40, 22), Position = UDim2.new(1, -54, 0.5, -11),
                BackgroundColor3 = state and KRYVEX.Theme.Primary or KRYVEX.Theme.ToggleOff, Text = "", AutoButtonColor = false,
            })
            Toggle.Parent = Frame
            AddCorner(Toggle, 11)

            local Circle = Create("Frame", {
                Size = UDim2.fromOffset(16, 16), Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
                BackgroundColor3 = Color3.new(1, 1, 1),
            })
            Circle.Parent = Toggle
            AddCorner(Circle, 8)

            local function Update()
                PlayTween(Toggle, 0.15, { BackgroundColor3 = state and KRYVEX.Theme.Primary or KRYVEX.Theme.ToggleOff })
                PlayTween(Circle, 0.15, { Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) })
                if config.Callback then task.spawn(config.Callback, state) end
            end

            Toggle.Activated:Connect(function()
                state = not state
                Update()
            end)

            return { Set = function(_, val) state = val Update() end, Get = function() return state end }
        end

        function Tab:CreateSection(text)
            local Section = Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = text or "Section",
                TextColor3 = KRYVEX.Theme.Primary, TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
            })
            Section.Parent = Page
            return Section
        end

        return Tab
    end

    -- Select first tab automatically
    task.spawn(function()
        task.wait()
        if Window.Tabs[1] then Window.Tabs[1]:Select() end
    end)

    return Window
end

return KRYVEX
