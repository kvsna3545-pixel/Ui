local function Create(className, properties)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        pcall(function() object[property] = value end)
    end
    if properties and properties.BackgroundTransparency == nil and properties.Name ~= "Main" and object:IsA("GuiObject") then
        local color = properties.BackgroundColor3
        if color == KRYVEX.Theme.Card then
            object.BackgroundTransparency = KRYVEX.Glass.Card
        elseif color == KRYVEX.Theme.Background then
            object.BackgroundTransparency = KRYVEX.Glass.Inner
        end
    end
    return object
end

