        Title = title,
        Description = description,
    }

    function result:SetTitle(value)
        title.Text = tostring(value or "")
    end

    function result:SetDescription(value)
        description.Text = tostring(value or "")
    end

    function result:SetVisible(value)
        card.Visible = value == true
    end

    table.insert(self.Elements, result)

    return result
end

function SectionMethods:AddLabel(text)
    return self.Tab:AddLabel(text)
end

function SectionMethods:AddCard(config)
