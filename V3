local NotifContainer = New("Frame", {
    Name = "Notifications",
    Parent = ScreenGui,
    AnchorPoint = Vector2.new(1, 1),
    Position = UDim2.new(1, -16, 1, -16),
    Size = UDim2.fromOffset(320, 400),
    BackgroundTransparency = 1,
    ZIndex = 200,
})

