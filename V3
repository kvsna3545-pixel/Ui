function TabMethods:AddKeybind(config)
    config = config or {}

    local currentKey = config.Default or Enum.KeyCode.RightShift
    local callback = config.Callback or function() end
    local listening = false

    local row = New("Frame", {
        Name = "Keybind",
        Parent = self.Page,
        Size = UDim2.new(1, -4, 0, 42),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
    })

    Corner(row, 8)
    Stroke(row, Theme.Stroke, 1)

    MakeLabel(
        row,
        config.Name or "Keybind",
        UDim2.new(1, -110, 1, 0),
        UDim2.new(0, 12, 0, 0),
        12,
        Theme.Text,
        FontBold
    )

    local keyButton = New("TextButton", {
        Name = "KeyButton",
        Parent = row,
        Size = UDim2.fromOffset(90, 28),
        Position = UDim2.new(1, -100, 0.5, -14),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Text = currentKey.Name,
        TextColor3 = Theme.Gold,
        TextSize = 11,
        Font = FontBold,
        AutoButtonColor = false,
    })

    Corner(keyButton, 6)

    keyButton.Activated:Connect(function()
        listening = true
        keyButton.Text = "Press key..."
    end)

    local inputConnection

    inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard
                and input.KeyCode ~= Enum.KeyCode.Unknown then

                currentKey = input.KeyCode
                listening = false
                keyButton.Text = currentKey.Name
            end

            return
        end

        if processed then
            return
        end

        if input.UserInputType == Enum.UserInputType.Keyboard
            and input.KeyCode == currentKey then

            local ok, err = pcall(callback, currentKey)

            if not ok then
                warn("[ChristmasUI] Keybind callback error:", err)
            end
        end
    end)

    local result = {
        Frame = row,
        Button = keyButton,
    }

    function result:GetValue()
        return currentKey
    end

    function result:SetValue(key)
        if typeof(key) == "EnumItem"
            and key.EnumType == Enum.KeyCode then

            currentKey = key
            keyButton.Text = key.Name
            listening = false
        end
    end

    table.insert(self.Elements, result)

    return result
end

