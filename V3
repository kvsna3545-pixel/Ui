        12,
        Theme.Text,
        FontBold
    ).ZIndex = 6

    local selector = New("TextButton", {
        Name = "Selector",
        Parent = row,
        Position = UDim2.new(0.4, 0, 0, 6),
        Size = UDim2.new(0.6, -10, 0, 30),
