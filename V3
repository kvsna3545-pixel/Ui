        ZIndex = 6,
    })

    Corner(selector, 6)

    local list = New("ScrollingFrame", {
        Name = "MultiOptions",
        Parent = ScreenGui,
        Size = UDim2.fromOffset(180, 150),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Green,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 110,
    })

    Corner(list, 8)
    Stroke(list, Theme.Stroke, 1)
    Padding(list, 5)

    New("UIListLayout", {
        Parent = list,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 4),
    })

    local function updateText()
        local values = {}

        for _, option in ipairs(options) do
            if selected[option] then
                table.insert(values, tostring(option))
            end
        end

        selector.Text = (#values > 0 and table.concat(values, ", ") or "Select...")
            .. "  ▾"
    end

    local function close()
        opened = false
        list.Visible = false

        if activeDropdownClose == close then
            activeDropdownClose = nil
            DropdownOverlay.Visible = false
        end
    end

    local function reposition()
        local pos = selector.AbsolutePosition
        local size = selector.AbsoluteSize

        list.Position = UDim2.fromOffset(pos.X, pos.Y + size.Y + 4)
        list.Size = UDim2.fromOffset(math.max(160, size.X), 150)
    end

    local function rebuild()
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        for index, option in ipairs(options) do
            local value = option

            local button = New("TextButton", {
                Name = "Option_" .. index,
                Parent = list,
                Size = UDim2.new(1, -2, 0, 28),
                BackgroundColor3 = selected[value]
                    and Theme.GreenDark or Theme.Element,
                BorderSizePixel = 0,
                Text = (selected[value] and "✓  " or "    ")
                    .. tostring(value),
                TextColor3 = Theme.White,
                TextSize = 11,
                Font = Font,
                AutoButtonColor = false,
                LayoutOrder = index,
                ZIndex = 111,
            })

            Corner(button, 5)

            button.Activated:Connect(function()
                selected[value] = not selected[value] or nil

                rebuild()
                updateText()

                local values = {}

                for _, item in ipairs(options) do
                    if selected[item] then
                        table.insert(values, item)
                    end
                end

                local success, err = pcall(callback, values)

                if not success then
                    warn("[ChristmasUI] MultiDropdown callback error:", err)
                end
            end)
        end
    end

    selector.Activated:Connect(function()
        if opened then
            close()
            return
        end

        CloseActiveDropdown()

        opened = true
        activeDropdownClose = close
        DropdownOverlay.Visible = true
        list.Visible = true

        reposition()
        rebuild()
    end)

    local result = {
        Frame = row,
        Selector = selector,
    }

    function result:GetValue()
        local values = {}

        for _, option in ipairs(options) do
            if selected[option] then
                table.insert(values, option)
            end
        end

        return values
    end

    function result:SetOptions(newOptions)
        options = newOptions or {}
        rebuild()
        updateText()
        reposition()
    end

    function result:Close()
        close()
    end

    updateText()
    table.insert(self.Elements, result)

    return result
end

