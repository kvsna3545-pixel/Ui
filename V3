function TabMethods:AddDropdown(config)
    config = config or {}

    local options = config.Options or {}
    local selected = config.Default
    local callback = config.Callback or function() end
    local opened = false

    local row = New("Frame", {
        Name = "Dropdown",
        Parent = self.Page,
        Size = UDim2.new(1, -4, 0, 42),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        ZIndex = 5,
    })

    Corner(row, 8)
    Stroke(row, Theme.Stroke, 1)

    MakeLabel(
        row,
        config.Name or "Dropdown",
        UDim2.new(0.45, -10, 1, 0),
        UDim2.new(0, 12, 0, 0),
        12,
        Theme.Text,
        FontBold
    ).ZIndex = 6

    local selector = New("TextButton", {
        Name = "Selector",
        Parent = row,
        Position = UDim2.new(0.45, 0, 0, 6),
        Size = UDim2.new(0.55, -10, 0, 30),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Text = tostring(selected or "Select...") .. "  ▾",
        TextColor3 = Theme.White,
        TextSize = 11,
        Font = Font,
        AutoButtonColor = false,
        ZIndex = 6,
    })

    Corner(selector, 6)

    local list = New("ScrollingFrame", {
        Name = "Options",
        Parent = ScreenGui,
        Size = UDim2.fromOffset(180, 0),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Green,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 110,
    })

    Corner(list, 8)
    Stroke(list, Theme.Stroke, 1)

    Padding(list, 5)

    local layout = New("UIListLayout", {
        Parent = list,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 4),
    })

    local function reposition()
        if not row.Parent then
            return
        end

        local pos = selector.AbsolutePosition
        local size = selector.AbsoluteSize

        list.Position = UDim2.fromOffset(
            pos.X,
            pos.Y + size.Y + 4
        )

        list.Size = UDim2.fromOffset(
            math.max(160, size.X),
            math.min(150, math.max(36, #options * 32 + 10))
        )
    end

    local function close()
        opened = false
        list.Visible = false

        if activeDropdownClose == close then
            activeDropdownClose = nil
            DropdownOverlay.Visible = false
        end
    end

    local function setValue(value, fireCallback)
        selected = value
        selector.Text = tostring(value or "Select...") .. "  ▾"

        if fireCallback then
            local success, err = pcall(callback, selected)

            if not success then
                warn("[ChristmasUI] Dropdown callback error:", err)
            end
        end
    end

    local function rebuild()
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        for index, option in ipairs(options) do
            local optionValue = option

            local button = New("TextButton", {
                Name = "Option_" .. index,
                Parent = list,
                Size = UDim2.new(1, -2, 0, 28),
                BackgroundColor3 = Theme.Element,
                BorderSizePixel = 0,
                Text = tostring(optionValue),
                TextColor3 = Theme.Text,
                TextSize = 11,
                Font = Font,
                AutoButtonColor = false,
                LayoutOrder = index,
                ZIndex = 111,
            })

            Corner(button, 5)

            button.Activated:Connect(function()
                setValue(optionValue, true)
                close()
            end)
        end
    end

    selector.Activated:Connect(function()
        if opened then
            close()
            return
        end

        CloseActiveDropdown()

        opened = true
        activeDropdownClose = close
        DropdownOverlay.Visible = true
        list.Visible = true

        reposition()
        rebuild()
    end)

    local result = {
        Frame = row,
        Selector = selector,
    }

    function result:GetValue()
        return selected
    end

    function result:SetValue(value)
        setValue(value, true)
    end

    function result:SetOptions(newOptions)
        options = newOptions or {}
        rebuild()
        reposition()
    end

    function result:Close()
        close()
    end

    table.insert(self.Elements, result)

    return result
end

function TabMethods:AddMultiDropdown(config)
    config = config or {}

    local options = config.Options or {}
    local selected = {}

    for _, value in ipairs(config.Default or {}) do
        selected[value] = true
    end

    local callback = config.Callback or function() end
    local opened = false

    local row = New("Frame", {
        Name = "MultiDropdown",
