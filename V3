function TabMethods:AddCard(config)
    config = config or {}

    local card = New("Frame", {
        Name = "Card",
        Parent = self.Page,
        Size = config.Size or UDim2.new(1, -4, 0, 90),
        BackgroundColor3 = Theme.Secondary,
