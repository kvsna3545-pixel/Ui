local WindowMethods = {}
WindowMethods.__index = WindowMethods

local TabMethods = {}
TabMethods.__index = TabMethods

local SectionMethods = {}
SectionMethods.__index = SectionMethods

function Library:CreateWindow(config)
    config = config or {}

    local window = setmetatable({}, WindowMethods)

    window.Tabs = {}
    window.ActiveTab = nil
    window.Title = config.Title or "Christmas Hub"
    window.Subtitle = config.Subtitle or "Winter Edition"
    window.Destroyed = false

    local Main = New("Frame", {
        Name = "MainWindow",
        Parent = ScreenGui,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = config.Size or UDim2.fromOffset(650, 430),
        BackgroundColor3 = Theme.Main,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    })

    Corner(Main, 12)
    Stroke(Main, Theme.Stroke, 1)

    window.Window = Main

    local Header = New("Frame", {
        Name = "Header",
        Parent = Main,
        Size = UDim2.new(1, 0, 0, 62),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
    })

    local HeaderAccent = New("Frame", {
        Parent = Header,
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = Theme.Red,
        BorderSizePixel = 0,
    })

    Corner(HeaderAccent, 4)

    MakeLabel(
        Header,
        "🎄  " .. window.Title,
        UDim2.new(1, -120, 0, 28),
        UDim2.new(0, 18, 0, 7),
        17,
        Theme.Gold,
        FontBold
    )

    MakeLabel(
        Header,
        window.Subtitle,
        UDim2.new(1, -120, 0, 18),
        UDim2.new(0, 20, 0, 35),
        10,
        Theme.SubText,
        Font
    )

    local CloseButton = New("TextButton", {
        Name = "Close",
        Parent = Header,
        Size = UDim2.fromOffset(32, 32),
        Position = UDim2.new(1, -44, 0, 15),
        BackgroundColor3 = Theme.RedDark,
        Text = "×",
        TextColor3 = Theme.White,
        Font = FontBold,
        TextSize = 23,
        AutoButtonColor = false,
    })

    Corner(CloseButton, 8)

    CloseButton.Activated:Connect(function()
        window:Destroy()
    end)

    local Sidebar = New("ScrollingFrame", {
        Name = "Sidebar",
        Parent = Main,
        Position = UDim2.new(0, 0, 0, 62),
        Size = UDim2.new(0, 155, 1, -62),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Green,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    })

    Padding(Sidebar, 10)

    New("UIListLayout", {
        Parent = Sidebar,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 7),
    })

    local Content = New("Frame", {
        Name = "Content",
        Parent = Main,
        Position = UDim2.new(0, 155, 0, 62),
        Size = UDim2.new(1, -155, 1, -62),
        BackgroundColor3 = Theme.Main,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    })

    window.Sidebar = Sidebar
    window.Content = Content

    -- Drag window with mouse or touch.
    -- Excludes the close button.
    local dragging = false
    local dragStart
    local startPosition
    local dragInput

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = Main.Position
            dragInput = input

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    function window:CreateTab(name)
        name = tostring(name or "Tab")

        local tab = setmetatable({}, TabMethods)

        tab.Name = name
        tab.Sections = {}
        tab.Elements = {}

        tab.Button = New("TextButton", {
            Name = "Tab_" .. name,
            Parent = Sidebar,
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = Theme.Element,
            BackgroundTransparency = 0.25,
            Text = "  " .. name,
            TextColor3 = Theme.SubText,
            TextSize = 12,
            Font = FontBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
        })

        Corner(tab.Button, 7)

        tab.Page = New("ScrollingFrame", {
            Name = "Page_" .. name,
            Parent = Content,
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = Theme.Green,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
        })

        Padding(tab.Page, 12)

        tab.Layout = New("UIListLayout", {
            Parent = tab.Page,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 10),
        })

        function tab:Select()
            if window.Destroyed then
                return
            end

            for _, other in ipairs(window.Tabs) do
                other.Page.Visible = false

                Tween(other.Button, 0.15, {
                    BackgroundColor3 = Theme.Element,
                    TextColor3 = Theme.SubText,
                })
            end

            tab.Page.Visible = true
            window.ActiveTab = tab

            Tween(tab.Button, 0.15, {
                BackgroundColor3 = Theme.GreenDark,
                TextColor3 = Theme.White,
            })
        end

        tab.Button.Activated:Connect(function()
            tab:Select()
        end)

        table.insert(window.Tabs, tab)

        if #window.Tabs == 1 then
            tab:Select()
        end

        return tab
    end

    function window:Show()
        if Main and Main.Parent then
            Main.Visible = true
        end
    end

    function window:Hide()
        if Main and Main.Parent then
            Main.Visible = false
        end
    end

    function window:Toggle()
        if Main and Main.Parent then
            Main.Visible = not Main.Visible
        end
    end

    function window:Destroy()
        if window.Destroyed then
            return
        end

        window.Destroyed = true

        if Main and Main.Parent then
            Main:Destroy()
        end
    end

    return window
end

