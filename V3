function TabMethods:AddButton(config)
    config = config or {}

    local callback = config.Callback or function() end

    local button = New("TextButton", {
        Name = "Button",
        Parent = self.Page,
        Size = UDim2.new(1, -4, 0, 40),
        BackgroundColor3 = Theme.GreenDark,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    })

    Corner(button, 8)
    Stroke(button, Theme.Green, 1)

    local title = MakeLabel(
        button,
        config.Name or config.Title or "Button",
        UDim2.new(1, -42, 1, 0),
        UDim2.new(0, 12, 0, 0),
        12,
        Theme.White,
        FontBold
    )

    local arrow = MakeLabel(
        button,
        "›",
        UDim2.fromOffset(24, 32),
        UDim2.new(1, -30, 0.5, -16),
        24,
        Theme.Gold,
        FontBold
    )

    title.ZIndex = 2
    arrow.ZIndex = 2

    button.Activated:Connect(function()
        Tween(button, 0.1, {
            BackgroundColor3 = Theme.Green,
        })

        task.delay(0.12, function()
            if button.Parent then
                Tween(button, 0.15, {
                    BackgroundColor3 = Theme.GreenDark,
                })
            end
        end)

        local success, err = pcall(callback)

        if not success then
            warn("[ChristmasUI] Button callback error:", err)
            Library.Notify("Button Error", tostring(err), 5)
        end
    end)

    local result = {
        Frame = button,
        Button = button,
        Title = title,
    }

    function result:SetText(text)
        title.Text = tostring(text or "")
    end

    function result:SetEnabled(enabled)
        button.Active = enabled == true
        button.AutoButtonColor = enabled == true
        button.BackgroundTransparency = enabled and 0 or 0.5
    end

    table.insert(self.Elements, result)

    return result
end

function TabMethods:AddToggle(config)
    config = config or {}

    local callback = config.Callback or function() end
    local value = config.Default == true

    local row = New("Frame", {
        Name = "Toggle",
        Parent = self.Page,
        Size = UDim2.new(1, -4, 0, 42),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
    })

    Corner(row, 8)
    Stroke(row, Theme.Stroke, 1)

    local title = MakeLabel(
        row,
        config.Name or "Toggle",
        UDim2.new(1, -75, 1, 0),
        UDim2.new(0, 12, 0, 0),
        12,
        Theme.Text,
        Font
    )

    local switch = New("TextButton", {
        Name = "Switch",
        Parent = row,
        Size = UDim2.fromOffset(42, 22),
        Position = UDim2.new(1, -54, 0.5, -11),
        BackgroundColor3 = value and Theme.Green or Theme.Element,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    })

    Corner(switch, 11)

    local knob = New("Frame", {
        Name = "Knob",
        Parent = switch,
        Size = UDim2.fromOffset(16, 16),
        Position = value
            and UDim2.new(1, -19, 0.5, -8)
            or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
    })

    Corner(knob, 8)

    local function updateVisual()
        Tween(switch, 0.15, {
            BackgroundColor3 = value and Theme.Green or Theme.Element,
        })

        Tween(knob, 0.15, {
            Position = value
                and UDim2.new(1, -19, 0.5, -8)
                or UDim2.new(0, 3, 0.5, -8),
        })
    end

    local function setValue(newValue, fireCallback)
        value = newValue == true
        updateVisual()

        if fireCallback then
            local success, err = pcall(callback, value)

            if not success then
                warn("[ChristmasUI] Toggle callback error:", err)
                Library.Notify("Toggle Error", tostring(err), 5)
            end
        end
    end

    switch.Activated:Connect(function()
        setValue(not value, true)
    end)

    row.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            local position = input.Position
            local switchPosition = switch.AbsolutePosition
            local switchSize = switch.AbsoluteSize

            local insideSwitch =
                position.X >= switchPosition.X
                and position.X <= switchPosition.X + switchSize.X
                and position.Y >= switchPosition.Y
                and position.Y <= switchPosition.Y + switchSize.Y

            if not insideSwitch then
                setValue(not value, true)
            end
        end
    end)

    local result = {
        Frame = row,
        Switch = switch,
        Title = title,
    }

    function result:GetValue()
        return value
    end

    function result:SetValue(newValue)
        setValue(newValue, true)
    end

    function result:SetText(text)
        title.Text = tostring(text or "")
    end

    table.insert(self.Elements, result)

    return result
end

