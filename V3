function TabMethods:AddSlider(config)
    config = config or {}

    local minimum = tonumber(config.Min) or 0
    local maximum = tonumber(config.Max) or 100

    if maximum < minimum then
        maximum, minimum = minimum, maximum
    end

    local value = math.clamp(
        tonumber(config.Default) or minimum,
        minimum,
        maximum
    )

    local callback = config.Callback or function() end

    local row = New("Frame", {
        Name = "Slider",
        Parent = self.Page,
        Size = UDim2.new(1, -4, 0, 64),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
    })

    Corner(row, 8)
    Stroke(row, Theme.Stroke, 1)

    local title = MakeLabel(
        row,
        config.Name or "Slider",
        UDim2.new(0.7, 0, 0, 24),
        UDim2.new(0, 12, 0, 5),
        12,
        Theme.Text,
        FontBold
    )

    local valueLabel = MakeLabel(
        row,
        tostring(value),
        UDim2.new(0.25, -10, 0, 24),
        UDim2.new(0.75, 0, 0, 5),
        12,
        Theme.Gold,
        FontBold
    )

    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = New("Frame", {
        Name = "Track",
        Parent = row,
        Position = UDim2.new(0, 12, 0, 40),
        Size = UDim2.new(1, -24, 0, 8),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
    })

    Corner(track, 5)

    local fill = New("Frame", {
        Name = "Fill",
        Parent = track,
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Green,
        BorderSizePixel = 0,
    })

    Corner(fill, 5)

    local knob = New("Frame", {
        Name = "Knob",
        Parent = track,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
    })

    Corner(knob, 8)
    Stroke(knob, Theme.Green, 2)

    local hitbox = New("TextButton", {
        Name = "Hitbox",
        Parent = row,
        Position = UDim2.new(0, 6, 0, 30),
        Size = UDim2.new(1, -12, 0, 28),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    })

    local function updateVisual()
        local alpha = 0

        if maximum > minimum then
            alpha = (value - minimum) / (maximum - minimum)
        end

        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
    end

    local function setValue(newValue, fireCallback)
        newValue = math.clamp(
            tonumber(newValue) or minimum,
            minimum,
            maximum
        )

        if config.Decimals ~= true then
            newValue = math.floor(newValue + 0.5)
        else
            newValue = math.floor(newValue * 100 + 0.5) / 100
        end

        value = newValue
        updateVisual()

        if fireCallback then
            local success, err = pcall(callback, value)

            if not success then
                warn("[ChristmasUI] Slider callback error:", err)
                Library.Notify("Slider Error", tostring(err), 5)
            end
        end
    end

    local dragging = false

    local function updateFromX(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then
            return
        end

        local alpha = math.clamp(
            (x - track.AbsolutePosition.X) / width,
            0,
            1
        )

        setValue(minimum + (maximum - minimum) * alpha, true)
    end

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            updateFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            updateFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    updateVisual()

    local result = {
        Frame = row,
        Track = track,
        Title = title,
    }

    function result:GetValue()
        return value
    end

    function result:SetValue(newValue)
        setValue(newValue, true)
    end

    table.insert(self.Elements, result)

    return result
end

