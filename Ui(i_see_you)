-- Seasonal palettes: clone the neutral palette so every required UI color exists.
local function KRYVEXMakeTheme(base, overrides, isHalloween)
    local theme = {}
    for k, v in pairs(base) do theme[k] = v end
    for k, v in pairs(overrides) do theme[k] = v end
    theme.IsHalloween = isHalloween or false
    return theme
end

