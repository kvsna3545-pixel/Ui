                )

                task.wait(D)

                PlayTween(
                    Star,
                    D,
                    { BackgroundTransparency = 0.92 },
                    Enum.EasingStyle.Sine
                )

                task.wait(D)

            end

        end)

    end

    ----------------------------------------------------
    -- ORBITING PLANETS (เธ”เธฒเธงเน€เธเธฃเธฒเธฐเธซเนเนเธเธเธฃ + เธซเธฒเธเธเธฒเธ)
    ----------------------------------------------------

    local Orbiters = {

        {
            Radius = 46,
            Size = 7,
            Speed = 1.1,
            Phase = 0,
            Color = Light,
        },

        {
            Radius = 54,
            Size = 5,
            Speed = -0.75,
            Phase = 2.1,
            Color = Silver,
        },

        {
            Radius = 62,
            Size = 4,
            Speed = 0.5,
            Phase = 4.2,
            Color = Mid,
        },

    }

    local Tilt = math.rad(-20)

    for _, Orbiter in ipairs(Orbiters) do

        Orbiter.Dots = {}

        for k = 1, 4 do

            local Dot =
                Create(
                    "Frame",
                    {
                        AnchorPoint =
                            Vector2.new(0.5, 0.5),

                        Size =
                            UDim2.fromOffset(
                                Orbiter.Size
                                    * (1 - (k - 1) * 0.2),
                                Orbiter.Size
                                    * (1 - (k - 1) * 0.2)
                            ),

                        BackgroundColor3 =
                            Orbiter.Color,

                        BackgroundTransparency =
                            (k - 1) * 0.22,

                        BorderSizePixel = 0,
                        ZIndex = 7,
                    }
                )

            Dot.Parent = FX

            AddCorner(Dot, 10)

            if k == 1 then

                AddStroke(
                    Dot,
                    Orbiter.Color,
                    0.55,
                    2
                )

            end

            Orbiter.Dots[k] = Dot

        end

    end

    local Clock = 0
    local Conn

    Conn =
        RunService.Heartbeat:Connect(
            function(dt)

                if not Alive() then
                    Conn:Disconnect()
                    return
                end

                Clock = Clock + dt

                for _, Orbiter in ipairs(Orbiters) do

                    local Dir =
                        Orbiter.Speed > 0 and 1 or -1

                    for k, Dot in ipairs(Orbiter.Dots) do

                        local A =
                            Orbiter.Phase
                            + Clock * Orbiter.Speed
                            - (k - 1) * 0.16 * Dir

                        local X =
                            math.cos(A) * Orbiter.Radius

                        local Y =
                            math.sin(A)
                            * Orbiter.Radius * 0.8

                        local RX =
                            X * math.cos(Tilt)
                            - Y * math.sin(Tilt)

                        local RY =
                            X * math.sin(Tilt)
                            + Y * math.cos(Tilt)

                        Dot.Position =
                            UDim2.new(
                                0.5, RX,
                                0.5, RY
                            )

                        -- เธซเธเนเธฒ/เธซเธฅเธฑเธ เนเธซเนเธ”เธนเธกเธตเธกเธดเธ•เธด
                        local Depth =
                            1 + 0.25 * math.sin(A)

                        local S =
                            Orbiter.Size
                            * (1 - (k - 1) * 0.2)
                            * Depth

                        Dot.Size =
                            UDim2.fromOffset(S, S)

                    end

                end

            end
        )

    ----------------------------------------------------
    -- SHOOTING STAR (เธ”เธฒเธงเธ•เธเน€เธเธตเธขเธ”เธเธญเธเธเธธเนเธก)
