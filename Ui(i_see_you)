function KRYVEX:SetTheme(mode)
    mode = string.lower(tostring(mode or "normal"))
    local aliases = {
        grey="normal", default="normal", normal="normal",
        halloween="halloween", xmas="christmas", christmas="christmas",
        valentine="valentines", valentines="valentines", love="valentines",
        summer="summer", auto="auto",
    }
    mode = aliases[mode] or "normal"

    if mode == "auto" then
        local ok, d = pcall(function() return os.date("*t") end)
        if ok and type(d) == "table" then
            if d.month == 10 and d.day >= 6 and d.day <= 31 then
                mode = "halloween"
            elseif d.month == 12 and d.day >= 1 and d.day <= 31 then
                mode = "christmas"
            elseif d.month == 2 and d.day <= 14 then
                mode = "valentines"
            elseif d.month >= 3 and d.month <= 5 then
                mode = "summer"
            else
                mode = "normal"
            end
        else
            mode = "normal"
        end
    end

    self.ThemeMode = mode
    local map = {
        normal="Normal", halloween="Halloween", christmas="Christmas",
        valentines="Valentines", summer="Summer",
    }
    self.Theme = self.Themes[map[mode]] or self.Themes.Normal
    self.Theme.IsHalloween = (mode == "halloween")
    return self.Theme
end

