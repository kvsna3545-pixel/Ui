local LucideModule = nil
local LucideTried = false

local function GetLucide()

    if LucideTried then
        return LucideModule
    end

    LucideTried = true

    if not KRYVEX.UseLucide then
        return nil
    end

    local ok, result =
        pcall(function()

            return loadstring(
                game:HttpGet(
                    KRYVEX.LucideUrl
                )
            )()

        end)

    if ok
        and type(result) == "table"
        and result.GetAsset
    then
        LucideModule = result
    else
        warn(
            "[Kryvex Hub] \u{E42}\u{E2B}\u{E25}\u{E14} Lucide \u{E44}\u{E21}\u{E48}\u{E44}\u{E14}\u{E49} \u{E43}\u{E0A}\u{E49}\u{E2A}\u{E31}\u{E0D}\u{E25}\u{E31}\u{E01}\u{E29}\u{E13}\u{E4C}\u{E2A}\u{E33}\u{E23}\u{E2D}\u{E07}\u{E41}\u{E17}\u{E19}"
        )
    end

    return LucideModule

end

local function GetLucideIcon(name)

    local lucide = GetLucide()

    if not lucide then
        return nil
    end

    local candidates = {
        name,
        KRYVEX.IconAliases[name],
    }

    for _, candidate in ipairs(candidates) do

        local ok, asset =
            pcall(
                lucide.GetAsset,
                candidate
            )

        if ok and asset and asset.Url then

            return {
                Image = asset.Url,
                ImageRectOffset =
                    asset.ImageRectOffset,
                ImageRectSize =
                    asset.ImageRectSize,
            }

        end

    end

    return nil

end

-- เน€เธยเน€เธเธ—เน€เธยเน€เธยเน€เธยเน€เธเธ’: "image", เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…เน€เธเธเน€เธเธเน€เธย  เน€เธเธเน€เธเธเน€เธเธ—เน€เธเธ  "glyph", เน€เธโ€ขเน€เธเธ‘เน€เธเธเน€เธเธเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธ
local function ResolveIcon(
    icon
)

    if icon == nil
        or icon == ""
    then
        return nil
    end

    if type(icon) == "number" then

        return
            "image",
            {
                Image =
                    "rbxassetid://"
                    .. tostring(icon)
            }

    end

    if type(icon) == "table" then

        return
            "image",
            icon

    end

    icon =
        tostring(icon)

    if icon:find("rbxassetid://", 1, true)
        or icon:find("rbxthumb://", 1, true)
        or icon:find("rbxasset://", 1, true)
        or icon:match("^https?://")
    then

        return
            "image",
            {
                Image = icon
            }

    end

    if icon:match("^%d+$") then

        return
            "image",
            {
                Image =
                    "rbxassetid://"
                    .. icon
            }

    end

    local key =
        string.lower(icon)

    key =
        key:gsub("^lucide:", "")

    local registered =
        KRYVEX.Icons[key]

    if registered then

        if type(registered) == "table" then

            return
                "image",
                registered

        end

        return
            "image",
            {
                Image =
                    tostring(
                        registered
                    )
            }

    end

    local lucideIcon =
        GetLucideIcon(key)

    if lucideIcon then

        return
            "image",
            lucideIcon

    end

    return
        "glyph",
        KRYVEX.IconGlyphs[key]
        or "\u{25C8}"

end

