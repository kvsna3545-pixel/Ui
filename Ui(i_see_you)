-- CREATE ICON (เธชเธฃเนเธฒเธเนเธญเธเธญเธเธเธฃเธดเธเธเธฒเธเธเธทเนเธญ/เนเธญเธ”เธต)
-- KRYVEX.CreateIcon("ghost", { Size, Position, AnchorPoint, Color, ZIndex })
-- เธเธทเธเธเนเธฒ: object, kind  ("image" = เนเธญเธเธญเธเธเธฃเธดเธ, "glyph" = เธชเธฑเธเธฅเธฑเธเธฉเธ“เนเธชเธณเธฃเธญเธ)
--=========================================================

function KRYVEX.CreateIcon(icon, props)

    props = props or {}

    local kind, data =
        ResolveIcon(icon)

    if not kind then
        return nil
    end

    local object

    if kind == "image" then

        object =
            Create(
                "ImageLabel",
                {
                    Name = props.Name or "Icon",
                    AnchorPoint = props.AnchorPoint,
                    Position = props.Position,

                    Size =
                        props.Size
                        or UDim2.fromOffset(18, 18),

                    BackgroundTransparency = 1,
                    Image = data.Image or "",

                    ImageRectOffset =
                        data.ImageRectOffset
                        or Vector2.zero,

                    ImageRectSize =
                        data.ImageRectSize
                        or Vector2.zero,

                    ImageColor3 =
                        props.Color
                        or KRYVEX.Theme.Text,

                    ImageTransparency =
                        props.Transparency or 0,

                    ScaleType = Enum.ScaleType.Fit,
                    ZIndex = props.ZIndex or 1,
                }
            )

    else

        object =
            Create(
                "TextLabel",
                {
                    Name = props.Name or "Icon",
                    AnchorPoint = props.AnchorPoint,
                    Position = props.Position,

                    Size =
                        props.Size
                        or UDim2.fromOffset(18, 18),

                    BackgroundTransparency = 1,
                    Text = data,

                    TextColor3 =
                        props.Color
                        or KRYVEX.Theme.Text,

                    TextTransparency =
                        props.Transparency or 0,

                    TextSize = props.TextSize or 16,
                    Font = Enum.Font.GothamBold,
                    ZIndex = props.ZIndex or 1,
                }
            )

    end

    return object, kind

end

