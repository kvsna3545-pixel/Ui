                                62,
                                38
                            ),

                        Position =
                            UDim2.new(
                                1,
                                -72,
                                0,
                                28
                            ),

                        BackgroundColor3 =
                            KRYVEX.Theme.PrimaryDark,

                        Text =
                            "RUN",

                        TextColor3 =
                            Color3.new(
                                1,
                                1,
                                1
                            ),

                        TextSize =
                            10,

                        Font =
                            Enum.Font.GothamBold,

                        AutoButtonColor =
                            false,

                    }
                )

            RunButton.Parent =
                Frame

            AddCorner(
                RunButton,
                KRYVEX.Corners.Inner
            )

            local function Execute()

                local Command =
                    Input.Text

                if Command == "" then
                    return
                end

                if config.Callback then

                    task.spawn(
                        config.Callback,
                        Command
                    )

                end

            end

            RunButton.Activated:Connect(
                Execute
            )

            Input.FocusLost:Connect(
                function(EnterPressed)

                    if EnterPressed then
                        Execute()
                    end

                end
            )

            return {

                Input =
                    Input,

                Run =
                    Execute,

                Get = function()

                    return Input.Text

                end,

                Set = function(
                    _,
                    Text
                )

                    Input.Text =
                        tostring(
                            Text or ""
                        )

                end

            }

        end

        return Tab

    end

    --=====================================================
    -- FLOATING GUI
    --=====================================================

    local FloatGui =
        Create(
            "ScreenGui",
            {

                Name =
                    "KRYVEX_Floating",

                ResetOnSpawn =
                    false,

                IgnoreGuiInset =
                    true,

                ZIndexBehavior =
                    Enum.ZIndexBehavior.Sibling,

            }
        )

    FloatGui.Parent =
        GetParent()

    Window.FloatGui =
        FloatGui

    --=====================================================
    -- FLOATING BUTTON
    --=====================================================

    local FloatButton =
        Create(
            "ImageButton",
            {

                Name =
                    "ToggleButton",

                Size =
                    UDim2.fromOffset(
                        58,
                        58
                    ),

                Position =
                    UDim2.new(
                        0,
                        20,
                        0.5,
                        -29
                    ),

                BackgroundColor3 =
                    KRYVEX.Theme.FloatBg,

                BackgroundTransparency =
                    0.05,

                Image =
                    "rbxassetid://94330006523484",

                ScaleType =
                    Enum.ScaleType.Fit,

                AutoButtonColor =
                    false,

            }
        )

    FloatButton.Parent =
        FloatGui

    AddCorner(
        FloatButton,
        12
    )

    local FloatStroke =
        AddStroke(
            FloatButton,
            Color3.fromRGB(
                255,
                255,
                255
            ),
            0,
            2
        )

    -- เน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธโ€”เน€เธเธ’เน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ•เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธ’เน€เธเธเน€เธเธเน€เธเธ”เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธ
    local FloatGradient =
        Instance.new(
            "UIGradient"
        )

    FloatGradient.Color =
        ColorSequence.new({

            ColorSequenceKeypoint.new(
                0,
                KRYVEX.Theme.FloatEdge1
            ),

            ColorSequenceKeypoint.new(
                0.5,
                KRYVEX.Theme.FloatEdge2
            ),

            ColorSequenceKeypoint.new(
                1,
                KRYVEX.Theme.FloatEdge1
            ),

        })

    FloatGradient.Parent =
        FloatStroke

    task.spawn(function()

        while
            FloatButton.Parent
            and not Window.Destroyed
        do

            FloatGradient.Rotation =
                0

            local Spin =
                TweenService:Create(
                    FloatGradient,
                    TweenInfo.new(
                        4,
                        Enum.EasingStyle.Linear
                    ),
                    {
                        Rotation = 360
                    }
                )

            Spin:Play()

            Spin.Completed:Wait()

        end

    end)

    local FloatScale =
        Instance.new(
            "UIScale"
        )

    FloatScale.Scale =
        1

    FloatScale.Parent =
        FloatButton

    Window.FloatButton =
        FloatButton

    FixImage(
        FloatButton,
        "\u{E1B}\u{E38}\u{E48}\u{E21}\u{E40}\u{E1B}\u{E34}\u{E14}\u{E1B}\u{E34}\u{E14}"
    )

    --=====================================================
    -- SPACE EFFECT
    --=====================================================

    if KRYVEX.SpaceEffect ~= false then
        KRYVEX.BuildSpaceEffect(
            FloatButton,
            Window
        )
    end

    --=====================================================
    -- FLOAT DRAG
    --=====================================================

    local floatDragging =
        false

    local floatDragStart
    local floatStartPosition

    local floatMoved =
        false

    FloatButton.InputBegan:Connect(
        function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1
                or
                input.UserInputType ==
                Enum.UserInputType.Touch
            then

                floatDragging =
                    true

                floatMoved =
                    false

                floatDragStart =
                    input.Position

                floatStartPosition =
                    FloatButton.Position

                input.Changed:Connect(
                    function()

                        if input.UserInputState ==
                            Enum.UserInputState.End
                        then

                            floatDragging =
                                false

                        end

                    end
                )

            end

        end
    )

    UserInputService.InputChanged:Connect(
        function(input)

            if not floatDragging then
                return
            end

            if input.UserInputType ==
                Enum.UserInputType.MouseMovement
                or
                input.UserInputType ==
                Enum.UserInputType.Touch
            then

                local delta =
                    input.Position
                    - floatDragStart

                if math.abs(delta.X) > 5
                    or
                    math.abs(delta.Y) > 5
                then

                    floatMoved =
                        true

                end

                FloatButton.Position =
                    UDim2.new(

                        floatStartPosition.X.Scale,

                        floatStartPosition.X.Offset
                        + delta.X,

                        floatStartPosition.Y.Scale,

                        floatStartPosition.Y.Offset
                        + delta.Y

                    )

            end

        end
    )

    --=====================================================
    -- FLOAT CLICK
    --=====================================================

    FloatButton.Activated:Connect(
        function()

            if floatMoved then
                return
            end

            if Window.Destroyed then
                return
            end

            local down =
                PlayTween(
                    FloatScale,
                    0.08,
                    {
                        Scale = 0.86
                    }
                )

            down.Completed:Wait()

            PlayTween(
                FloatScale,
                0.25,
                {
                    Scale = 1
                },
                Enum.EasingStyle.Back
            )

            Window:ToggleVisibility()

        end
    )

    --=====================================================
    -- FLOAT HOVER
    --=====================================================

    FloatButton.MouseEnter:Connect(
        function()

            PlayTween(
                FloatScale,
                0.18,
                {
                    Scale = 1.08
                }
            )

            PlayTween(
                FloatStroke,
                0.18,
                {
                    Thickness = 2.5
                }
            )

        end
    )

    FloatButton.MouseLeave:Connect(
        function()

            PlayTween(
                FloatScale,
                0.18,
                {
                    Scale = 1
                }
            )

            PlayTween(
                FloatStroke,
                0.18,
                {
                    Thickness = 2
                }
            )

        end
    )

    --=====================================================
    -- OPENING ANIMATION
    --=====================================================

    HideScale.Scale =
        0.85

    Main.BackgroundTransparency =
        1

    BgImage.ImageTransparency =
        1

    PlayTween(
        BgImage,
        0.6,
        {
            ImageTransparency =
                KRYVEX.Background.Transparency
        }
    )

    -- Different entrance motion for each seasonal theme.
    local introStyle, introDirection, introTime = Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0.42
    if KRYVEX.ThemeMode == "halloween" then
        introStyle, introDirection, introTime = Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0.62
        HideScale.Scale = 0.72
    elseif KRYVEX.ThemeMode == "christmas" then
        introStyle, introDirection, introTime = Enum.EasingStyle.Elastic, Enum.EasingDirection.Out, 0.72
        HideScale.Scale = 0.82
    elseif KRYVEX.ThemeMode == "valentines" then
        introStyle, introDirection, introTime = Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0.58
        HideScale.Scale = 0.86
    elseif KRYVEX.ThemeMode == "summer" then
        introStyle, introDirection, introTime = Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0.38
        HideScale.Scale = 0.90
    else
        HideScale.Scale = 0.94
    end

    PlayTween(HideScale, introTime, {Scale = 1}, introStyle, introDirection)
    PlayTween(Main, introTime, {
        Size = UDim2.fromOffset(Window.Size.X, Window.Size.Y),
        Position = UDim2.new(0.5, -Window.Size.X / 2, 0.5, -Window.Size.Y / 2),
        BackgroundTransparency = KRYVEX.Glass.Main
    }, introStyle, introDirection)

    --=====================================================
    -- WELCOME
    --=====================================================

    task.delay(
        0.5,
        function()

            if not Window.Destroyed then

                Window:Notify({

                    Title =
                        "Kryvex Hub v"
                        .. KRYVEX.Version,

                    Content =
                        "Library Loaded Successfully \u{1F525}",

                    Duration =
                        3

                })

            end

        end
    )

    --=====================================================
    -- RETURN
    --=====================================================

            return Window

end

