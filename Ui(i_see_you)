            local DecoClock = 0
            local DecoConn

            DecoConn =
                RunService.Heartbeat:Connect(
                    function(dt)

                        if Window.Destroyed then
                            DecoConn:Disconnect()
                            return
                        end

                        DecoClock = DecoClock + dt

                        -- เนเธญเธเธญเธเนเธ–เธเธซเธฑเธง: เธฅเธญเธขเธเธถเนเธเธฅเธ + เน€เธญเธตเธขเธเน€เธเธฒเน
                        if HeaderIcon then

                            HeaderIcon.Position =
                                UDim2.new(
                                    1, -98,
                                    0.5, math.sin(DecoClock * 3) * 2
                                )

                            HeaderIcon.Rotation =
                                math.sin(DecoClock * 2.2) * 10

                        end

                        -- เนเธญเธเธญเธเธกเธธเธกเธฅเนเธฒเธ: เธฅเธญเธขเธเธถเนเธเธฅเธ + เธเธฒเธเน€เธเนเธฒเธญเธญเธ
                        if CornerIcon then

                            CornerIcon.Position =
                                UDim2.new(
                                    0, 10,
                                    1, -8 + math.sin(DecoClock * 1.6) * 3
                                )

                            local fade =
                                0.3 + 0.2 * math.sin(DecoClock * 1.3)

                            if CornerKind == "image" then
                                CornerIcon.ImageTransparency = fade
                            else
                                CornerIcon.TextTransparency = fade
                            end

                        end

                    end
                )

        end

