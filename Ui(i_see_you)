                task.delay(1.3, function()
                    Paw:Destroy()
                end)

            end

        else

            local Ember =
                Create(
                    "Frame",
                    {
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position =
                            UDim2.new(
                                x, math.random(-12, 12),
                                y, -40 + math.random(-10, 10)
                            ),
                        Size = UDim2.fromOffset(4, 4),
                        BackgroundColor3 = Theme.Primary,
                        BackgroundTransparency = 0.1,
                        BorderSizePixel = 0,
                        ZIndex = 6,
                    }
                )

            Ember.Parent = Root

            Round(Ember)

            Tw(Ember, 0.7, {
                BackgroundTransparency = 1,
                Position =
                    UDim2.new(
                        x, math.random(-20, 20),
                        y, -70
                    ),
            })

            task.delay(0.75, function()
                Ember:Destroy()
            end)

        end

    end

    local function WolfRun()

        local Wolf =
            KRYVEX.CreateIcon(
                KRYVEX.DecoIcons.Wolf or "dog",
                {
                    AnchorPoint = Vector2.new(0.5, 1),
                    Position = UDim2.new(-0.12, 0, 0.94, 0),
                    Size = UDim2.fromOffset(96, 96),
                    Color = Theme.FxWhite,
                    TextSize = 72,
                    ZIndex = 7,
                }
            )

        if Wolf then
            Wolf.Parent = Root
        end

        local RunIn, Leap, RunOut = 1.1, 1.0, 0.8
        local Total = RunIn + Leap + RunOut

        local Elapsed = 0
        local Trail = 0
        local Finished = false
        local Pulsed = false
        local Titled = false
        local Conn

        Conn =
            RunService.Heartbeat:Connect(function(dt)

                if not Alive() then
                    Conn:Disconnect()
                    Finished = true
                    return
                end

                Elapsed = Elapsed + dt
                Trail = Trail + dt

                local X, Y, Rot, OnGround

                if Elapsed < RunIn then

                    local U = Elapsed / RunIn

                    X = -0.12 + 0.46 * U
                    Y = 0.94 - math.abs(math.sin(U * math.pi * 5)) * 0.025
                    Rot = math.sin(U * math.pi * 5) * 6
                    OnGround = true

                elseif Elapsed < RunIn + Leap then

                    local U = (Elapsed - RunIn) / Leap

                    X = 0.34 + 0.34 * U
                    Y = 0.94 - 0.62 * math.sin(U * math.pi)
                    Rot = -32 + 64 * U
                    OnGround = false

                    -- เธ–เธถเธเธเธธเธ”เธชเธนเธเธชเธธเธ”: เธเธฃเธฐเธเธฑเธเธ—เธฃเนเธงเธฒเธ + เน€เธชเธตเธขเธเธซเธญเธ
                    if U > 0.45 and not Pulsed then

                        Pulsed = true

                        Tw(Halo, 0.25, { Transparency = 0.4 })
                        Tw(Moon, 0.25, { BackgroundTransparency = 0 })

                        task.delay(0.3, function()
                            Tw(Halo, 0.5, { Transparency = 0.78 })
                            Tw(Moon, 0.5, { BackgroundTransparency = 0.12 })
                        end)

                        if Howl then
                            pcall(function()
                                Howl:Play()
                            end)
                        end

                    end

                else

                    local U =
                        math.min((Elapsed - RunIn - Leap) / RunOut, 1)

                    X = 0.68 + 0.46 * U
                    Y = 0.94 - math.abs(math.sin(U * math.pi * 4)) * 0.025
                    Rot = math.sin(U * math.pi * 4) * 6
                    OnGround = true

                end

                if Wolf then
                    Wolf.Position = UDim2.new(X, 0, Y, 0)
                    Wolf.Rotation = Rot
                end

                if Elapsed > RunIn + Leap and not Titled then
                    Titled = true
                    ShowTitle()
                end

                if Trail >= (OnGround and 0.14 or 0.05) then
                    Trail = 0
                    SpawnTrail(X, Y, OnGround)
                end

                if Elapsed >= Total then
                    Conn:Disconnect()
                    Finished = true
                end

            end)

        while not Finished and Alive() do
            task.wait()
        end

        if Wolf then
            Wolf:Destroy()
        end

    end

    ----------------------------------------------------
    -- TIMELINE
    ----------------------------------------------------

    task.spawn(function()

        pcall(function()

            Tw(Dim, 0.5, { BackgroundTransparency = 0.45 })

            for _, Frame in ipairs(Edges) do
                Tw(Frame, 0.6, { BackgroundTransparency = 0 })
            end

            task.wait(0.55)

            task.spawn(Lightning)

            task.wait(0.15)

            Tw(
                Moon,
                0.9,
                { Size = UDim2.fromOffset(MoonSize, MoonSize) },
                Enum.EasingStyle.Back
            )

            Crow(0.0, 0.22, 26, 3.2)
            Crow(0.25, 0.30, 20, 3.4)
            Crow(0.45, 0.18, 22, 3.0)
            Crow(0.7, 0.38, 16, 3.6)
            Crow(0.9, 0.26, 18, 3.2)

            EyePair(0.06, 0.45, 0.5)
            EyePair(0.95, 0.6, 1.1)
            EyePair(0.08, 0.78, 1.7)

            task.wait(0.9)

            WolfRun()

            -- เธเนเธฒเธเนเธเธงเนเธเธทเนเธญ เนเธฅเนเธงเธเนเธญเธขเน เธเธฒเธเธ—เธฑเนเธเธซเธกเธ”
            task.wait(1.1)

            for _, Frame in ipairs(Edges) do
                Tw(Frame, 0.8, { BackgroundTransparency = 1 })
            end

            Tw(Dim, 0.8, { BackgroundTransparency = 1 })

            Tw(
                Moon,
                0.7,
                { Size = UDim2.fromOffset(0, 0) },
                Enum.EasingStyle.Back,
                Enum.EasingDirection.In
            )

            if TitleObjects[1] then
                Tw(TitleObjects[1], 0.6, { TextTransparency = 1 })
                Tw(TitleObjects[2], 0.6, { Transparency = 1 })
                Tw(TitleObjects[3], 0.6, { TextTransparency = 1 })
            end

            task.wait(0.9)

        end)

        if Root.Parent then
            Root:Destroy()
        end

    end)

end

