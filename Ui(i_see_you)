                        TextXAlignment =
                            Enum.TextXAlignment.Right,

                    }
                )

            ValueLabel.Parent =
                Frame

            local Bar =
                Create(
                    "Frame",
                    {

                        Size =
                            UDim2.new(
                                1,
                                -28,
                                0,
                                6
                            ),

                        Position =
                            UDim2.fromOffset(
                                14,
                                43
                            ),

                        BackgroundColor3 =
                            KRYVEX.Theme.ToggleOff,

                    }
                )

            Bar.Parent =
                Frame

            AddCorner(
                Bar,
                6
            )

            local Fill =
                Create(
                    "Frame",
                    {

                        Size =
                            UDim2.new(

                                (
                                    value - min
                                )
                                /
                                (
                                    max - min
                                ),

                                0,

                                1,
                                0

                            ),

                        BackgroundColor3 =
                            KRYVEX.Theme.Primary,

                    }
                )

            Fill.Parent =
                Bar

            AddCorner(
                Fill,
                6
            )

            local Hitbox =
                Create(
                    "TextButton",
                    {

                        Size =
                            UDim2.new(
                                1,
                                0,
                                0,
                                24
                            ),

                        Position =
                            UDim2.new(
                                0,
                                0,
                                0.5,
                                -12
                            ),

                        BackgroundTransparency =
                            1,

                        Text = "",

                        AutoButtonColor =
                            false,

                    }
                )

            Hitbox.Parent =
                Bar

            local sliding =
                false

            local function SetValue(
                newValue
            )

                value =
                    math.clamp(
                        newValue,
                        min,
                        max
                    )

                local percent =
                    (
                        value - min
                    )
                    /
                    (
                        max - min
                    )

                Fill.Size =
                    UDim2.new(
                        percent,
                        0,
                        1,
                        0
                    )

                ValueLabel.Text =
                    tostring(
                        math.floor(
                            value
                        )
                    )

                if config.Callback then

                    task.spawn(
                        config.Callback,
                        value
                    )

                end

            end

            Hitbox.InputBegan:Connect(
                function(input)

                    if input.UserInputType ==
                        Enum.UserInputType.MouseButton1
                        or
                        input.UserInputType ==
                        Enum.UserInputType.Touch
                    then

                        sliding =
                            true

                    end

                end
            )

            UserInputService.InputEnded:Connect(
                function(input)

                    if input.UserInputType ==
                        Enum.UserInputType.MouseButton1
                        or
                        input.UserInputType ==
                        Enum.UserInputType.Touch
                    then

                        sliding =
                            false

                    end

                end
            )

            UserInputService.InputChanged:Connect(
                function(input)

                    if not sliding then
                        return
                    end

                    if input.UserInputType ==
                        Enum.UserInputType.MouseMovement
                        or
                        input.UserInputType ==
                        Enum.UserInputType.Touch
                    then

                        local percent =
                            math.clamp(

                                (
                                    input.Position.X
                                    -
                                    Bar.AbsolutePosition.X
                                )
                                /
                                Bar.AbsoluteSize.X,

                                0,
                                1

                            )

                        SetValue(

                            min
                            +
                            (
                                max - min
                            )
                            *
                            percent

                        )

                    end

                end
            )

            return {

                Set = function(
                    _,
                    newValue
                )

                    SetValue(
                        newValue
                    )

                end,

                Get = function()

                    return value

                end

            }

        end

