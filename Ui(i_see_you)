            return math.floor(
                Stats
                    .Network
                    .ServerStatsItem[
                        "Data Ping"
                    ]
                    :GetValue()
            )

        end)

    if success and result then

        return result

    end

    local success2, result2 =
        pcall(function()

            local text =
