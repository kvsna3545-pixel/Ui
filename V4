local NotifContainer = New("Frame", {
    Name = "Notifications",
    Parent = ScreenGui,
    AnchorPoint = Vector2.new(1, 1),
    Position = UDim2.new(1, -20, 1, -20),
    Size = UDim2.fromOffset(320, 400),
