local FontBold = Enum.Font.GothamBold

-- ═══════════════════════════════════════
-- 🔧 HELPERS
-- ═══════════════════════════════════════
local function New(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end
local function Corner(p, r) return New("UICorner", {CornerRadius = UDim.new(0, r or 8), Parent = p}) end
local function Stroke(p, c, t) return New("UIStroke", {Color = c or Theme.Stroke, Thickness = t or 1, Parent = p}) end
local function Padding(p, pad) return New("UIPadding", {
    PaddingTop = UDim.new(0, pad), PaddingBottom = UDim.new(0, pad),
    PaddingLeft = UDim.new(0, pad), PaddingRight = UDim.new(0, pad),
    Parent = p
}) end
local function Tween(o, t, p) TweenService:Create(o, TweenInfo.new(t or 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), p):Play() end

-- ─── Safe parent for ScreenGui ───
local function GetGuiParent()
    -- Try CoreGui first (works in most executors)
    local ok = pcall(function()
        local g = Instance.new("Folder")
        g.Parent = CoreGui
        g:Destroy()
    end)
    if ok then return CoreGui end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local guiParent = GetGuiParent()

-- ═══════════════════════════════════════
-- 📌 CREATE GUI
-- ═══════════════════════════════════════
local function GetScreenGui()
    local old = guiParent:FindFirstChild("ChristmasUI")
    if old then old:Destroy() end
    return New("ScreenGui", {
        Name = "ChristmasUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        Parent = guiParent
    })
end
local ScreenGui = GetScreenGui()

-- ─── Dropdown overlay (global for all dropdowns) ───
local DropdownOverlay = New("TextButton", {
    Parent = ScreenGui,
    Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1,
    Text = "",
    Visible = false,
    ZIndex = 900,
    AutoButtonColor = false,
})
local activeDropdownClose = nil
DropdownOverlay.MouseButton1Click:Connect(function()
    if activeDropdownClose then activeDropdownClose() end
end)

-- ═══════════════════════════════════════
-- ❄️ SNOW (per-window, respects visibility)
-- ═══════════════════════════════════════
local function CreateSnow(window)
    local folder = New("Folder", {Name = "Snow", Parent = window})
    task.spawn(function()
        while folder.Parent do
            if window.Visible then
                local flake = New("Frame", {
                    Parent = folder,
                    Size = UDim2.fromOffset(math.random(2, 5), math.random(2, 5)),
                    Position = UDim2.new(math.random(), 0, -0.05, 0),
                    BackgroundColor3 = Theme.White,
                    BackgroundTransparency = math.random(30, 60) / 100,
                    BorderSizePixel = 0,
                    ZIndex = 50
                })
                New("UICorner", {CornerRadius = UDim.new(1, 0), Parent = flake})

                local dur   = math.random(60, 140) / 10
                local drift = math.random(-40, 40) / 1000
                TweenService:Create(flake, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
                    Position = UDim2.new(flake.Position.X.Scale + drift, 0, 1.05, 0),
                    BackgroundTransparency = 1
                }):Play()

                task.delay(dur, function()
                    if flake and flake.Parent then flake:Destroy() end
                end)
            end
            task.wait(math.random(30, 120) / 100)
        end
    end)
end

