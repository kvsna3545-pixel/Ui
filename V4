-- ═══════════════════════════════════════
-- 🎄 THEME
-- ═══════════════════════════════════════
local Theme = {
    Main      = Color3.fromRGB(20, 20, 25),
    Secondary = Color3.fromRGB(30, 30, 38),
    Element   = Color3.fromRGB(42, 42, 52),
    Stroke    = Color3.fromRGB(60, 60, 72),
    Red       = Color3.fromRGB(196, 30, 58),
    RedDark   = Color3.fromRGB(150, 20, 40),
    Green     = Color3.fromRGB(34, 139, 34),
    GreenDark = Color3.fromRGB(20, 100, 20),
    Gold      = Color3.fromRGB(255, 200, 80),
    White     = Color3.fromRGB(240, 245, 255),
    Text      = Color3.fromRGB(240, 240, 245),
